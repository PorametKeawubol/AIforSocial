# LINE Messaging API (LINE Developers Console -> Messaging API)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Flask
PORT=5000
LOG_LEVEL=INFO

# KFC data source.  The scraper reads KFC Thailand's public, dynamic content
# configuration at runtime, so no Contentful token is stored here.
KFC_CONFIG_URL=https://www.kfc.co.th/api/v2/configs/th
KFC_MENU_URL=https://www.kfc.co.th/menu/meals
KFC_PROMOTION_URL=https://www.kfc.co.th/promos-rewards
KFC_STORE_LOCATOR_URL=https://www.kfc.co.th/store-locator
# Optional order landing page used for the `order` intent reply.
KFC_ORDER_URL=https://www.kfc.co.th/
KFC_LOCALE=th-TH
# Include current menus alongside promotions.
KFC_INCLUDE_MENUS=true

# Scraper/browser fallback
HEADLESS=true
SCRAPER_TIMEOUT_SECONDS=25
MAX_RESULTS=10
# Number of meal cards returned by the `menu` Flex carousel (the lab uses 5).
MENU_CAROUSEL_RESULTS=5
# Cache the live image list so a second `menu` reply uses the short-lived
# LINE reply token immediately instead of opening a browser/catalog request.
MENU_IMAGE_CACHE_SECONDS=600
PAGE_SETTLE_SECONDS=5
CHROMEDRIVER_AUTO_INSTALL=true
# Set only when Chrome/Chromium is not discoverable on PATH.
CHROME_BINARY=
SCRAPER_USE_SELENIUM_FALLBACK=true
SAVE_HTML=false
HTML_OUTPUT_DIR=artifacts

# Semantic (BERT) search
SEMANTIC_SEARCH_ENABLED=true
BERT_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_MIN_SCORE=0.26
# Intent classification (six supported intents plus `other` fallback).
INTENT_SEMANTIC_ENABLED=true
INTENT_MIN_SCORE=0.70

# Prevent duplicate replies if LINE redelivers the same webhook event.
WEBHOOK_EVENT_TTL_SECONDS=600
WEBHOOK_EVENT_MAX_ENTRIES=1000

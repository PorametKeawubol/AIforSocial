<graphml xmlns="http://graphml.graphdrawing.org/xmlns"><key id="name" for="node" attr.name="name" attr.type="string" /><key id="kind" for="node" attr.name="kind" attr.type="string" /><key id="relation" for="edge" attr.name="relation" attr.type="string" /><key id="page" for="edge" attr.name="page" attr.type="string" /><key id="evidence" for="edge" attr.name="evidence" attr.type="string" /><graph id="model_i" edgedefault="directed"><node id="8e4b21f8f8b4bfd45936a069"><data key="name">PVY</data><data key="kind">Pathogen</data></node><node id="d551361c36fd5bb08c520d9e"><data key="name">TEV (Tobacco etch virus)</data><data key="kind">Pathogen</data></node><node id="968b02bb8e9e0df305c7998f"><data key="name">กรดจัด</data><data key="kind">Topic</data></node><node id="45801be96bb64ff58e843de2"><data key="name">กลางแผลสีเทา หรือขาว</data><data key="kind">Symptom</data></node><node id="6814aa8f6ae53e00ddac82c7"><data key="name">กลุ่มเชื้อราเป็นผงสีขาวหรือเทา</data><data key="kind">Symptom</data></node><node id="373fa42ff05e696fa0ae3d01"><data key="name">การควบคุมในเบื้องต้น</data><data key="kind">Topic</data></node><node id="50c702c482fd7d68a8825aff"><data key="name">การปรับปรุงดินก่อนการเพาะปลูก</data><data key="kind">Treatment</data></node><node id="859df953e0bcef98ea76f515"><data key="name">การปลูกพริก</data><data key="kind">Topic</data></node><node id="7fcbb764ea25901dca866634"><data key="name">การป้องกันและกำจัด</data><data key="kind">Treatment</data></node><node id="f94c158b63a84565383d0f0e"><data key="name">การห่มดิน</data><data key="kind">Treatment</data></node><node id="5bd175bfa0996ad1d5756ccb"><data key="name">การห่มดิน</data><data key="kind">Topic</data></node><node id="c0e03ef19b67b427ee8d69f8"><data key="name">การแก้ปัญหาดินเค็ม</data><data key="kind">Topic</data></node><node id="9f1ac49292a6a7c64e8da30e"><data key="name">การใช้พรมใยปาล์มซึ่งทำมาจากปาล์มที่ผ่านการรีดน้ำมันแล้ว</data><data key="kind">Topic</data></node><node id="036a08d2be240f724ae8af37"><data key="name">การใช้สารเคมี</data><data key="kind">Treatment</data></node><node id="622e70eb65a83b056f3929af"><data key="name">กำจัดเพลี้ยอ่อน</data><data key="kind">Treatment</data></node><node id="c76e6a8a6b503b7aa520f858"><data key="name">ขอบแผลสีน้ำตาลเข้ม</data><data key="kind">Symptom</data></node><node id="c5d5b1b95fb072bf5d2add59"><data key="name">ข้าวโพด</data><data key="kind">Crop</data></node><node id="c4a11be05e12c69c17a1959d"><data key="name">ความเค็มของดิน</data><data key="kind">Topic</data></node><node id="cc3ba5f08427c397ad0cd774"><data key="name">ความเป็นกรดเป็นด่างของดิน</data><data key="kind">Topic</data></node><node id="3ec7b796d7e704e0a1280f9a"><data key="name">จุดฉ่ำน้ำรูปวงรีหรือรูปไข่</data><data key="kind">Symptom</data></node><node id="a4feae66e99493f560fc686d"><data key="name">จุดสีดำเรียงซ้อนกันในแผล</data><data key="kind">Symptom</data></node><node id="11a2ad9b68099025985b08b6"><data key="name">จุลินทรีย์ตาย</data><data key="kind">Symptom</data></node><node id="1c1fd0484974f9f0214542f3"><data key="name">จุลินทรีย์ที่ไม่เป็นประโยชน์</data><data key="kind">Pathogen</data></node><node id="272986670f7fc46e0ca306fb"><data key="name">จุลินทรีย์ในดิน</data><data key="kind">Pathogen</data></node><node id="45fa0b2ea4a8630d155f99b5"><data key="name">จุลินทรีย์ในดิน</data><data key="kind">Topic</data></node><node id="12181b2ca355b0ce1ecdf204"><data key="name">ช่วยคลุมหน้าดินไม่ให้วัชพืชขึ้นรบกวนต้นไม้พืชหลัก</data><data key="kind">Topic</data></node><node id="ce2db968342cd8a04d91e61f"><data key="name">ดอกตัวผู้จะหงิกงอ ไม่เจริญเต็มที่</data><data key="kind">Symptom</data></node><node id="411474151b1a864132701ca0"><data key="name">ดาวเรืองและงา</data><data key="kind">Topic</data></node><node id="98db94e8bf7dc8d0a6acd977"><data key="name">ดิน</data><data key="kind">Topic</data></node><node id="38f09999ea39ab02bd7a3352"><data key="name">ดินเปรี้ยว</data><data key="kind">Topic</data></node><node id="4a8eef81b3e095852f2075e9"><data key="name">ดินเปรี้ยวหรือดินเค็ม</data><data key="kind">Topic</data></node><node id="431dd9d20a96f9c554f2410f"><data key="name">ดินเปรี้ยวหรือดินเป็นกรด</data><data key="kind">Topic</data></node><node id="9dba120b2872efe97b5d5ac2"><data key="name">ตัดแต่งส่วนที่เป็นโรค นำไปเผาทำลายนอกแปลงปลูก</data><data key="kind">Treatment</data></node><node id="ea574ccf0a060a7fe13fc97f"><data key="name">ต้นตายได้</data><data key="kind">Symptom</data></node><node id="5f6a5e2aa650727ef05a5120"><data key="name">ต้นพริก</data><data key="kind">Crop</data></node><node id="6507b47d0015ef5b3100f440"><data key="name">ต้นแคระแกร็น</data><data key="kind">Symptom</data></node><node id="3bb95e689ae5748a93784373"><data key="name">ต้นแห้งตาย</data><data key="kind">Symptom</data></node><node id="f3966b9208e027e9048ef2ea"><data key="name">ถอนต้นและกำจัดเศษซากต้นพริกที่เป็นโรคไปเผาทำลาย กำจัดวัชพืชไม่ให้เป็นแหล่งอาศัยของเพลี้ยอ่อน</data><data key="kind">Topic</data></node><node id="93a78ed335a4093b5eec3f0d"><data key="name">ถั่ว</data><data key="kind">Crop</data></node><node id="db296e1caeb5caa39197c4bc"><data key="name">ทฤษฏีการห่มดิน</data><data key="kind">Topic</data></node><node id="2d784ef56a6763c2af821f27"><data key="name">ทุเรียน</data><data key="kind">Crop</data></node><node id="9237270c3da335d11cc6efd9"><data key="name">นาข้าว</data><data key="kind">Topic</data></node><node id="049ad54d39f36e880abf1157"><data key="name">น้ำมันทาร์</data><data key="kind">Topic</data></node><node id="e21414cb616f57d48885ee83"><data key="name">น้ำมันเบา</data><data key="kind">Topic</data></node><node id="d8dac12a442757598e65c9c6"><data key="name">น้ำส้มควันไม้</data><data key="kind">Treatment</data></node><node id="028ea2124575cb227f85672e"><data key="name">น้ำส้มไม้</data><data key="kind">Topic</data></node><node id="413ee79851eab71e24326d5c"><data key="name">น้ำหมักสมุนไพร</data><data key="kind">Treatment</data></node><node id="604bc0fdb8d91b097e9cb564"><data key="name">น้ำหมักสมุนไพรรสจืด</data><data key="kind">Treatment</data></node><node id="0685670e66a510ace17aa64f"><data key="name">ประจุดเหลือง</data><data key="kind">Symptom</data></node><node id="9df8f070a8f9824458308e98"><data key="name">ปลูกข้าวโพดพันธุ์ต้านทาน</data><data key="kind">Treatment</data></node><node id="d3e1883070e9f88bda73cc37"><data key="name">ปลูกพืชหมุนเวียน</data><data key="kind">Treatment</data></node><node id="b243d0dd865e8263da6e3502"><data key="name">ปี 2558</data><data key="kind">Topic</data></node><node id="0485e1149c8e0c5db90cfa46"><data key="name">ปีแห่งดินสากล</data><data key="kind">Topic</data></node><node id="5d950581baa0f796293cf872"><data key="name">ปุ๋ยเคมี</data><data key="kind">Treatment</data></node><node id="739a2dffed22c8d7c2bf03bd"><data key="name">ผงคล้ายแป้งสีขาวปกคลุมใบแก่</data><data key="kind">Symptom</data></node><node id="5c213df2461a7a3145d327c9"><data key="name">ผงสปอร์สีขาวๆ เป็นจำนวนมากบริเวณใต้ใบ</data><data key="kind">Symptom</data></node><node id="c7bcfc6855e30e737b7870bb"><data key="name">พริก</data><data key="kind">Crop</data></node><node id="64cd1c4c64bf95519f3abe08"><data key="name">พืช</data><data key="kind">Crop</data></node><node id="d63f7a5abb23eb071bc9f809"><data key="name">พืชตระกูลถั่ว เช่น ถั่วลิสง หรือปอเทือง</data><data key="kind">Topic</data></node><node id="9c575dee8d41163be7e6ffaf"><data key="name">พืชหมุนเวียน</data><data key="kind">Topic</data></node><node id="119a3d0e6fed6c26ee5480cf"><data key="name">พ่นห่างกัน 7 วัน ไม่ควรใช้สารชนิดเดียวกันเกิน 3 ครั้ง เพราะจะทำให้เชื้อสาเหตุเกิดการดื้อยา</data><data key="kind">Treatment</data></node><node id="6594203ec8453591cb3e773d"><data key="name">ฟอสอีทิล-อะลูมิเนียม 80% ดับเบิลยูพี</data><data key="kind">Treatment</data></node><node id="73b577982c7ada971b59d90b"><data key="name">มีสีเขียวอ่อนสลับสีเขียวเข้ม หรือ สีเหลือง หรือจุดเหลืองกระจายตามใบ ต้นแคระแกร็น ไม่ออกดอก ใบเล็กลง ผลมีจุดสีเหลืองซีด ผิวผลหยาบ ผลมีรูปร่างผิดปกติ</data><data key="kind">Symptom</data></node><node id="ba6922c697d629712f186f27"><data key="name">มีแผลขนาดเล็กสีคล้ายฟางข้าวบนใบข้าวโพด และขยายใหญ่ขึ้นเป็นสีเทาหรือสีน้ำตาลอ่อน ยาวตามใบข้าวโพด ทำให้ ใบข้าวโพดแห้งตาย</data><data key="kind">Symptom</data></node><node id="32afdcc9e94ae9184fb5d877"><data key="name">มูลวัวควาย</data><data key="kind">Treatment</data></node><node id="065f8bd6f5de8ef9c7f3dec6"><data key="name">ยอดข้าวโพดมีสีซีด เหี่ยวเฉา ต่อมาจะไหม้ลุกลามเป็นยอดเน่า</data><data key="kind">Symptom</data></node><node id="fe0f607013b8801decd444f7"><data key="name">ยอดและกิ่งใบจะลู่ลงในช่วงกลางวัน และฟื้นตัวในช่วงกลางคืน</data><data key="kind">Symptom</data></node><node id="517061ac7af39da3b650d567"><data key="name">ยืนต้นตายขณะที่ใบยังเขียวอยู่ได้ภายใน 2 ถึง 3 วัน</data><data key="kind">Symptom</data></node><node id="ebb58a88073738d276b3ed0d"><data key="name">รอยไหม้สีดำบริเวณลำต้น</data><data key="kind">Symptom</data></node><node id="777c362a38e5da79f204ff18"><data key="name">รากเป็นปมและเน่า</data><data key="kind">Symptom</data></node><node id="9bb65c1c95f47e87889123f2"><data key="name">ราเมล็ดผักกาด</data><data key="kind">Pathogen</data></node><node id="3b19e9406b9f283a096e0779"><data key="name">ราเม็ดผักกาด</data><data key="kind">Pathogen</data></node><node id="7c677f01be6453210352fdb3"><data key="name">ฤดูฝน</data><data key="kind">Topic</data></node><node id="693112a13c1fcba38c6b7b74"><data key="name">ลายเขียวซีดสลับเขียวเข้ม</data><data key="kind">Symptom</data></node><node id="6b6d21081b0d10da2e17bfc1"><data key="name">วัชพืช</data><data key="kind">Topic</data></node><node id="1a7f47de2b02914cfc629b3c"><data key="name">วันดินโลก</data><data key="kind">Topic</data></node><node id="80cf4dca4247330e7d91b23a"><data key="name">วันที่ 5 ธันวาคมของทุกปี</data><data key="kind">Topic</data></node><node id="b1895868d75dec72ca00e9b3"><data key="name">สารชีวภาพ</data><data key="kind">Treatment</data></node><node id="581426b096e55ecb0c80c02f"><data key="name">สารดับกลิ่นตัว</data><data key="kind">Topic</data></node><node id="1b98739b6d832a60fe6aab37"><data key="name">สารปรับปรุงดิน</data><data key="kind">Treatment</data></node><node id="5252e1a3558448b53e6cd2d1"><data key="name">สารป้องกันกำจัดโรคพืช อะโซซิสโตรบิน+ ไดฟีโนโคนาโซล อัตรา 15 ซีซี/น้ำ 20 ลิตร โพรพิโคนาโซล อัตรา 20 ซีซี/น้ำ 20 ลิตร โพรพิโคนาโซล+ไดฟีโนโคนาโซล อัตรา 5 ซีซี/น้ำ 20 ลิตร</data><data key="kind">Treatment</data></node><node id="173f37c8dd4f1b25445d58c7"><data key="name">สารฟอสฟอริกแอซิด</data><data key="kind">Treatment</data></node><node id="4bddb99f582b4fa285ec3c12"><data key="name">สารเมตาแลกซิลหรือสารอีทริไดอะโซล หรือสารพีซีเอ็นบีผสมอีทริไดอะโซล หรือสารชีวภัณฑ์ราดดินบริเวณที่ถอนต้นออกไป</data><data key="kind">Treatment</data></node><node id="797b6ed835d9d60f9528b805"><data key="name">สารเมทาแลกซิล หรือสารฟอสอีทิล-อะลูมิเนียม</data><data key="kind">Treatment</data></node><node id="36bbdafcac06b850ef5cf287"><data key="name">สารแมนโคเซบ</data><data key="kind">Treatment</data></node><node id="d46f77ee13fe167e809de4d8"><data key="name">สารไดพีโนโคนาโซล 25% อัตรา 20-30 ซีซี ต่อ น้ำ 20 ลิตร หรือแมนโคเซบ 80% อัตรา 40 กรัม ต่อน้ำ 20 ลิตร พ่นทุก 7 วัน จำนวน 2-4 ครั้ง</data><data key="kind">Treatment</data></node><node id="e164027b2a023b45e7eb801c"><data key="name">สารไดเมโทมอร์ฟ อัตรา 20 กรัม/เมล็ด 1 กิโลกรัม</data><data key="kind">Treatment</data></node><node id="03ac9916f4a5b448ae817efb"><data key="name">สารไดโนแคป ไตรโฟรีน และเบโนมิล</data><data key="kind">Treatment</data></node><node id="5ef34b1bd3cd01710866f469"><data key="name">สูตรน้ำส้มสายชู</data><data key="kind">Treatment</data></node><node id="29921bb6558fbde474777b85"><data key="name">สูตรน้ำหัวผักกาด</data><data key="kind">Treatment</data></node><node id="e50bcc9bc863f03af0b59040"><data key="name">หลังใบจะเป็นสีเหลืองและเปลี่ยนเป็นสีน้ำตาลมีลักษณะเหลี่ยม</data><data key="kind">Symptom</data></node><node id="99bff5c3f645ddff5fdba290"><data key="name">อากาศถ่ายเทได้สะดวก</data><data key="kind">Topic</data></node><node id="a612df97816ced43e2f2c651"><data key="name">อินทรียวัตถุ</data><data key="kind">Topic</data></node><node id="54839d8a4a394732f6bd111b"><data key="name">เชื้อรา</data><data key="kind">Pathogen</data></node><node id="620a0b9a3f9ed0a1ca5db1ba"><data key="name">เชื้อราพิเทียม</data><data key="kind">Pathogen</data></node><node id="f8ead107f6409a313f13fe98"><data key="name">เชื้อราฟูซาเรียม</data><data key="kind">Pathogen</data></node><node id="9915bac6822ec88555d50419"><data key="name">เชื้อราฟูซาเรียม ออกซิสปอรัม</data><data key="kind">Pathogen</data></node><node id="8fb6d521ebdff43fffddd81d"><data key="name">เชื้อราสเคลอโรเทียม</data><data key="kind">Pathogen</data></node><node id="05c7ea31222c7c9a79a8513c"><data key="name">เชื้อราไตรโคเดอร์มา</data><data key="kind">Pathogen</data></node><node id="c12aec4cd7d67d6b1589bab0"><data key="name">เชื้อราไตรโคเดอร์มา</data><data key="kind">Treatment</data></node><node id="00f03a4349e0d241721c3661"><data key="name">เชื้อราไรซ็อกโทเนีย</data><data key="kind">Pathogen</data></node><node id="faa9ac0b39b172d940068aab"><data key="name">เชื้อแบคทีเรีย</data><data key="kind">Pathogen</data></node><node id="126d2e9895c6bc1b62a375d0"><data key="name">เนื้อแผลสีน้ำตาลอ่อน</data><data key="kind">Symptom</data></node><node id="9ef0264f637f3c940ddf8e3a"><data key="name">เปลือยดินไว้</data><data key="kind">Topic</data></node><node id="23811d8b22b04a76f21fa8c6"><data key="name">เพลี้ยอ่อน</data><data key="kind">Pathogen</data></node><node id="bcc948bdd630206ba940c108"><data key="name">เพิ่มอินทรียวัตถุให้กับดิน</data><data key="kind">Topic</data></node><node id="df77d561e3c033a9148e59fc"><data key="name">เมทาแลกซิล 25% ดับเบิลยูพี</data><data key="kind">Treatment</data></node><node id="1d1e04f00f78e1d89ea501eb"><data key="name">เมทาแลกซิล+แมนโคเซบ 65% ดับเบิลยูพี</data><data key="kind">Treatment</data></node><node id="7e909de24a58de8b0cbac708"><data key="name">เมือกสีส้มอ่อน</data><data key="kind">Symptom</data></node><node id="3068964de597bc7ec003d696"><data key="name">เส้นใบบวม ใส ใบด่าง หดย่น ต้นแคระแกร็น</data><data key="kind">Symptom</data></node><node id="1040108d3a312bead45e5912"><data key="name">แผลวงกลมหรือทางยาว</data><data key="kind">Symptom</data></node><node id="a8ade713c58eb1b5920ef1f7"><data key="name">แมลงในดิน</data><data key="kind">Pathogen</data></node><node id="160a355f74f2c1f6012ca6a4"><data key="name">โคนต้นและรากจะเน่าเกิดอาการเหี่ยวในระยะติดผล ผลมีลักษณะฉ่ำน้ำ เนื้อผลเป็นสีดำ ในขั้นรุนแรงจะเข้าทำลายเมล็ด และยืนต้นตาย</data><data key="kind">Symptom</data></node><node id="24e4b3fcc1aee7eb7b8aaba7"><data key="name">โรคกล้าไหม้</data><data key="kind">Disease</data></node><node id="c3a6d6d53388e23619c04b7c"><data key="name">โรคยอดเน่า</data><data key="kind">Disease</data></node><node id="cb53576c5fa1acf405ae2897"><data key="name">โรครา</data><data key="kind">Disease</data></node><node id="127ad4bbe4d4417cbe754b5c"><data key="name">โรครากปม</data><data key="kind">Disease</data></node><node id="0db8d79813e18fb386ab3029"><data key="name">โรครากเน่าและโคนเน่า</data><data key="kind">Disease</data></node><node id="603e8d9a7dcfaf41defe26ab"><data key="name">โรครากเน่าโคนเน่า</data><data key="kind">Disease</data></node><node id="4d60f5020607fa10d868e97b"><data key="name">โรคราน้ำค้าง</data><data key="kind">Disease</data></node><node id="e62e67d653167a60b3af8f17"><data key="name">โรคราน้ำค้างหรือโรคใบลาย</data><data key="kind">Disease</data></node><node id="19b88c82c65174d498c584ca"><data key="name">โรคราสนิม</data><data key="kind">Disease</data></node><node id="2f44f1cdea8b3259da15d936"><data key="name">โรคราแป้ง</data><data key="kind">Disease</data></node><node id="4182997fb0d397cc070e86e7"><data key="name">โรคลำต้นไหม้</data><data key="kind">Disease</data></node><node id="b7f0dccb22178363aa5f0fbc"><data key="name">โรคเข้าทำลายรุนแรง</data><data key="kind">Disease</data></node><node id="8c93beddc04c428844b7767a"><data key="name">โรคเชื้อรา</data><data key="kind">Disease</data></node><node id="55765f221c3d25f384948f09"><data key="name">โรคเน่า</data><data key="kind">Disease</data></node><node id="16e2047c061e3e32cb84bbe6"><data key="name">โรคเน่าคอดิน</data><data key="kind">Disease</data></node><node id="c967dbf956deab5a63c3a81e"><data key="name">โรคเหี่ยว</data><data key="kind">Disease</data></node><node id="4af19b039e35fa0be770e076"><data key="name">โรคเหี่ยวที่เกิดจากเชื้อราฟูซาเรียม ออกซิสปอรัม</data><data key="kind">Disease</data></node><node id="428bd52dbfbdfd6947ab7f69"><data key="name">โรคเหี่ยวในพืชผัก</data><data key="kind">Disease</data></node><node id="f88a93930d27588253202be2"><data key="name">โรคเหี่ยวในไม้ดอก</data><data key="kind">Disease</data></node><node id="74ea51304667f7f39370d476"><data key="name">โรคแคงเกอร์</data><data key="kind">Disease</data></node><node id="7d82f271141b1aff959d42c2"><data key="name">โรคแอนแทรกโนส</data><data key="kind">Disease</data></node><node id="8ec4959e00aa02f58fa00e13"><data key="name">โรคแอนแทร็กโนส</data><data key="kind">Disease</data></node><node id="753f60bf079221455bcbe250"><data key="name">โรคโคนเน่า</data><data key="kind">Disease</data></node><node id="800fb71945393ce79d60732d"><data key="name">โรคใบจุด</data><data key="kind">Disease</data></node><node id="e781e27971d331c366b2fc40"><data key="name">โรคใบจุดตากบ</data><data key="kind">Disease</data></node><node id="6e4006337867fd11f7bbb7bf"><data key="name">โรคใบด่าง</data><data key="kind">Disease</data></node><node id="19a9f18a7e5bcc335434ce0f"><data key="name">โรคใบด่างจากเชื้อไวรัส CVMV</data><data key="kind">Disease</data></node><node id="760f8b00dcb3c33574733b6c"><data key="name">โรคใบด่างที่เกิดจากเชื้อไวรัส CMV (Cucumber mosaic virus)</data><data key="kind">Disease</data></node><node id="50f6a005ccdf583dadf9b870"><data key="name">โรคใบหงิกเหลือง</data><data key="kind">Disease</data></node><node id="2d5c19f35ea193d636da23e3"><data key="name">โรคใบไหม้แผลใหญ่</data><data key="kind">Disease</data></node><node id="fa6d3618129174d84b882391"><data key="name">ใบข้าวโพดจะเป็นจุดนูนบนใบและใต้ใบ มีสีน้ำตาลอ่อนและเปลี่ยนเป็นน้ำตาลแดง เมื่อจุดนูนแตกมีผงสีคล้ายสนิม</data><data key="kind">Symptom</data></node><node id="fd0ae6d120423be911d726aa"><data key="name">ใบเหลือง</data><data key="kind">Symptom</data></node><node id="957c633032c59d7b71e4ef6a"><data key="name">ใบเหลือง เหี่ยว ร่วง และยืนต้นตาย</data><data key="kind">Symptom</data></node><node id="d5e4708f324d32959dc676c4"><data key="name">ใบเหลืองทั้งต้น</data><data key="kind">Symptom</data></node><node id="88d94e9c604ea604c20172c1"><data key="name">ใส่ปุ๋ย ไนโตรเจนปริมาณสูง</data><data key="kind">Treatment</data></node><node id="171e32b287942519325d6d13"><data key="name">ไนโตรเจน ฟอสฟอรัส โพแทสเซียม</data><data key="kind">Treatment</data></node><node id="0856ec5726af9b0854989a7c"><data key="name">ไส้เดือนฝอย</data><data key="kind">Pathogen</data></node><edge id="0" source="50c702c482fd7d68a8825aff" target="bcc948bdd630206ba940c108"><data key="relation">RELATED_TO</data><data key="page">6</data><data key="evidence">การห่มดินถือเป็นวิธีการที่เพิ่มอินทรีย

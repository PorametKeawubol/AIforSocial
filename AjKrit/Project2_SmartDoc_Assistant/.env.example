# Copy to .env locally. Never commit the real file.
PDF_PATH=./คู่มือประชาชน สำนักงานตำรวจแห่งชาติ.pdf
ARTIFACT_DIR=./artifacts
# LINE memory: successful turns; expiry checked when history is accessed.
HISTORY_MAX_TURNS=4
HISTORY_TTL_SECONDS=86400
INDEX_DIR=./artifacts/index

# Thai/multilingual embedding. BAAI/bge-m3 was benchmarked in this workspace.
EMBED_MODEL=BAAI/bge-m3
# Optional: Hugging Face access token removes anonymous-download rate limits.
# HF_TOKEN=
# Optional Grade-A cross-encoder reranker; leave empty for RRF-only mode.
RERANK_MODEL=BAAI/bge-reranker-v2-m3

OLLAMA_HOST=http://localhost:11434
# Production default selected from the local benchmark.
OLLAMA_MODEL=qwen3.5:9b
# Offline quality comparison: hf.co/unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_M
OLLAMA_TIMEOUT_SECONDS=180
TOP_K=5
CANDIDATE_K=24
MAX_CONTEXT_CHARS=10000
MAX_ANSWER_TOKENS=420
CHUNK_SIZE=900
CHUNK_OVERLAP=120
PARENT_SIZE=2400

SOURCE_TITLE=คู่มือประชาชน สำนักงานตำรวจแห่งชาติ
SOURCE_TOPIC=การติดต่อสถานีตำรวจ การขออนุญาต การป้องกันอาชญากรรม ภัยพิบัติ การใช้รถใช้ถนน และกฎหมายทั่วไป
SOURCE_URL=

# LINE credentials: put the rotated values here, never in source code.
ENABLE_LINE=true
CHANNEL_SECRET=
CHANNEL_ACCESS_TOKEN=
LINE_ACK_TEXT=รับคำถามแล้ว กำลังค้นจากคู่มือประชาชนและจะส่งคำตอบพร้อมแหล่งข้อมูลให้ครับ

# LINE Developers Console -> Messaging API
BOT_NAME=MercuMate
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Web server
PORT=5000
LOG_LEVEL=INFO

# Local, pre-scraped catalog. The webhook never waits for a live crawl.
MERCULAR_SNAPSHOT_PATH=data/mercular_products.json
SNAPSHOT_STALE_AFTER_HOURS=24

# Result selection
TOP_K=5
HISTORY_TTL_SECONDS=1800
HISTORY_SIZE=20

# NLP backend.  PhayaThaiBERT routes natural-language intent; the rule parser remains the
# exact extractor for price, brand, availability and sort constraints.
NLP_BACKEND=phayathaibert
PHAYATHAIBERT_MODEL_NAME=clicknext/phayathaibert
PHAYATHAIBERT_MIN_CONFIDENCE=0.30
# Set true after pre-downloading model weights in a deployment image/server.
PHAYATHAIBERT_LOCAL_FILES_ONLY=false

# Polite public-page scraper
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_RETRIES=3
SCRAPER_DELAY_SECONDS=1.0
MAX_PRODUCTS_PER_CATEGORY=20
SCRAPER_VERIFY_ROBOTS=true
# Preserve the last-known-good catalog when too many categories fail or the
# resulting catalog shrinks unexpectedly after a source-layout change.
SCRAPER_MIN_SUCCESS_RATIO=0.60
SCRAPER_MIN_RETENTION_RATIO=0.50
# Set true only for an intentional category/snapshot scope reduction.
SCRAPER_ALLOW_SHRINK=false
# Optional comma-separated category override. Empty uses the 13 targeted public
# category pages declared in config.py.
MERCULAR_CATEGORY_URLS=

# Promotion articles are synchronized separately from the product catalog.
MERCULAR_PROMOTION_SNAPSHOT_PATH=data/mercular_promotions.json
MERCULAR_PROMOTION_CATEGORY_URL=https://www.mercular.com/category-review-article/promotion

# Playwright product-detail enrichment.  Keep this outside the LINE webhook.
DETAIL_SCRAPER_TIMEOUT_SECONDS=45
DETAIL_SCRAPER_DELAY_SECONDS=5.0
# "hybrid" fetches the server-rendered Next.js payload directly and uses
# Playwright only when that payload is unavailable. Set "playwright" to force it.
DETAIL_SCRAPER_MODE=hybrid
# Normally blank after `playwright install chromium`; set this only when using a
# system Chromium binary, for example /usr/bin/chromium.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# Duplicate LINE event protection
WEBHOOK_EVENT_TTL_SECONDS=600
WEBHOOK_EVENT_MAX_ENTRIES=2000
WEBHOOK_MAX_BODY_BYTES=1000000
LINE_REPLY_CONNECT_TIMEOUT_SECONDS=2
LINE_REPLY_READ_TIMEOUT_SECONDS=5
# LINE loading animation is sent for one-on-one message/postback events.
# It runs in the background and automatically disappears when the reply arrives.
LINE_LOADING_ANIMATION_ENABLED=true

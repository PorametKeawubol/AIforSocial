# LINE Developers Console -> Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Advice scraper
ADVICE_URL=https://www.advice.co.th/wheretobuy
HEADLESS=true
SCRAPER_TIMEOUT_SECONDS=25
MAX_RESULTS=10
PAGE_SETTLE_SECONDS=5
CHROMEDRIVER_AUTO_INSTALL=true
# Optional: set this when Chrome/Chromium is not on the default PATH.
# CHROME_BINARY=/usr/bin/google-chrome
CHROME_BINARY=

# Optional: save Selenium page snapshots to artifacts/
SAVE_HTML=false
HTML_OUTPUT_DIR=artifacts

# Ignore a repeated delivery of the same LINE webhook event for 10 minutes.
WEBHOOK_EVENT_TTL_SECONDS=600
WEBHOOK_EVENT_MAX_ENTRIES=1000

PORT=5000
LOG_LEVEL=INFO
